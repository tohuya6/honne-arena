# Template. Copy to .env and fill in. Never commit real secrets.

# ── Required ──
# Sent as X-Admin-Token to the /api/admin routes. Empty disables admin.
ADMIN_TOKEN=
# Salt for hashing client IPs (rate limiting only, raw IPs are never stored).
#   python3 -c "import secrets; print(secrets.token_hex(32))"
IP_HASH_SALT=

DB_PATH=data/arena.db

# ── Model scoring (steering track) ──
# Off by default. NDIF is free for research but shared, see DECISIONS.md "NDIF use".
NDIF_ENABLED=false
# Get a key at https://login.ndif.us . Server-side only.
NDIF_API_KEY=
# "ndif", or "local" to run LOCAL_MODEL_ID on this machine (no NDIF calls).
SCORING_BACKEND=ndif
LOCAL_MODEL_ID=EleutherAI/pythia-70m
NDIF_CALLS_PER_DAY=150
NDIF_PLAYER_PER_DAY=10
NDIF_PLAYER_PER_MIN=2
NDIF_TIMEOUT_S=120

# ── Submissions ──
RATE_PER_MIN=10
RATE_PER_DAY=200

# ── CAPTCHA (Cloudflare Turnstile), optional ──
TURNSTILE_SECRET=
TURNSTILE_SITEKEY=

# ── Server ──
PORT=7860
# Empty = same-origin only, which is all the bundled frontend needs.
ALLOWED_ORIGIN=
TRUSTED_PROXY_HOPS=1
