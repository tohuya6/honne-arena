# Template. Copy to .env and fill in. Never commit real secrets.

# ── Required ──
# Sent as X-Admin-Token to the /api/admin routes. Empty disables token access.
ADMIN_TOKEN=
# Comma-separated. Signed-in users with these emails are admins.
ADMIN_EMAILS=
# Salt for hashing client IPs (rate limiting only, raw IPs are never stored).
#   python3 -c "import secrets; print(secrets.token_hex(32))"
IP_HASH_SALT=

DB_PATH=data/arena.db
# Public challenge files, served at /datasets.
PUBLIC_DIR=data/public

# ── Sign-in (magic link) ──
# Comma-separated. The email domain must match one exactly (no subdomains).
ALLOWED_EMAIL_DOMAINS=northeastern.edu
# Base of the emailed link: <PUBLIC_BASE_URL>/verify.html?token=...
PUBLIC_BASE_URL=http://localhost:7860
# true in production (HTTPS only cookie). false for plain http on localhost.
COOKIE_SECURE=false
LOGIN_TOKEN_MINUTES=15
SESSION_DAYS=30
# Sign-in emails per address per 15 minutes, and per client IP per hour.
LOGIN_PER_EMAIL=3
LOGIN_PER_IP_HOUR=10

# ── Email ──
# "console" logs the link (dev). "smtp" sends it.
EMAIL_BACKEND=console
# Dev only: return the link in the API response too (console backend only).
DEV_EXPOSE_LINKS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_TIMEOUT_S=10
EMAIL_FROM=

# ── Model scoring (steering track) ──
# Off by default. NDIF is free for research but shared, see DECISIONS.md "NDIF use".
NDIF_ENABLED=false
# Get a key at https://login.ndif.us . Server-side only.
NDIF_API_KEY=
# "ndif", or "local" to run LOCAL_MODEL_ID on this machine (no NDIF calls).
SCORING_BACKEND=ndif
LOCAL_MODEL_ID=EleutherAI/pythia-70m
NDIF_CALLS_PER_DAY=150
NDIF_PLAYER_PER_DAY=10
NDIF_PLAYER_PER_MIN=2
NDIF_TIMEOUT_S=120

# ── Submissions ──
RATE_PER_MIN=10
RATE_PER_DAY=200

# ── CAPTCHA (Cloudflare Turnstile), optional ──
TURNSTILE_SECRET=
TURNSTILE_SITEKEY=

# ── Server ──
PORT=7860
# Empty = same-origin only, which is all the bundled frontend needs.
ALLOWED_ORIGIN=
TRUSTED_PROXY_HOPS=1

# ── Live feed (/ws) ──
WS_MAX_CLIENTS=500
WS_QUEUE_SIZE=100
